# HeroSMS API key (from https://hero-sms.com — never commit the real value)
HEROSMS_API_KEY=

# Optional: auto | authorization-apikey | authorization-bearer | x-api-key | query
HEROSMS_AUTH_STYLE=auto

# Webhook sample receiver (herosms-webhook) — optional, not official HeroSMS auth
# HEROSMS_WEBHOOK_LISTEN=127.0.0.1:8787
# HEROSMS_WEBHOOK_PATH=/webhook/sms-incoming
# HEROSMS_WEBHOOK_ENFORCE_IPS=1
# HEROSMS_WEBHOOK_SECRET=
